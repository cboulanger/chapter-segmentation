Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.01-py3

# Apptainer container for the NuExtract-2.0-4B LoRA fine-tuning pilot on
# MPCDF HPC (Raven, NVIDIA GPUs). See ../README.md's "NuExtract-2.0-4B
# fine-tuning pilot" section for what this pilot does, and this
# directory's README.md for how to build/run this container.
#
# Bundles everything the pyproject.toml "nuextract-finetune" optional
# dependency group needs (torch ships with the base image already) plus
# a from-source llama.cpp build -- the pilot's design explicitly requires
# scoring accuracy only through llama.cpp/GGUF, never transformers'
# generation path (see evaluation/RESULTS.md's transformers/MPS-vs-
# llama.cpp finding), so convert_hf_to_gguf.py and llama-quantize must be
# available inside the container that runs evaluate_nuextract_finetune.py.
#
# Build (from a login node, needs --fakeroot to install apt/pip packages
# and compile llama.cpp -- see ../README.md):
#
#   module load apptainer/1.4.3
#   apptainer build --fakeroot nuextract.sif nuextract.def

%post
    set -e
    apt-get update
    apt-get install -y --no-install-recommends cmake git
    rm -rf /var/lib/apt/lists/*

    pip3 install --no-cache-dir \
        "transformers>=4.46.0" \
        "peft>=0.13.0" \
        "accelerate>=0.34.0" \
        "huggingface-hub>=0.25.0"

    # CUDA-accelerated build -- the base image ships the full CUDA
    # toolkit (nvcc etc.), so this picks up GPU offload automatically.
    #
    # Two things this build environment can't have, both handled below:
    #   - No GPU is attached during `%post` (this runs on a login node, or
    #     at best a CPU-only build step) -- leaving CMAKE_CUDA_ARCHITECTURES
    #     unset makes ggml's build try to autodetect via a live device
    #     ("-arch=native"), which finds nothing and silently falls back to
    #     nvcc's own default arch, possibly not matching the GPU this
    #     actually runs on later. Pin it explicitly instead: sm_80 (A100,
    #     Raven) and sm_90 (H100/H200, MPCDF's DAIS partition).
    #   - Login nodes cap the per-user process count (ulimit -u) well
    #     below what `nproc` parallel nvcc invocations spawn (each nvcc
    #     forks several sub-processes) -- an unbounded parallel build
    #     reliably exhausts that limit ("fork: retry: Resource temporarily
    #     unavailable"). Cap it explicitly rather than trusting nproc.
    export CMAKE_BUILD_PARALLEL_LEVEL=4
    CMAKE_ARGS="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=80;90" \
        pip3 install --no-cache-dir --force-reinstall --no-deps "llama-cpp-python>=0.3.0"

    # llama.cpp itself, for convert_hf_to_gguf.py + the llama-quantize
    # binary -- neither ships as a pip package. Building the full
    # default target (not just a single named target) is deliberate:
    # llama.cpp's internal target names/layout shift between releases,
    # so this trades a slightly longer build for not hardcoding a name
    # that may not exist in whatever revision is checked out at build
    # time. run_pilot.slurm locates the resulting binary with `find`
    # rather than assuming a fixed path for the same reason.
    git clone --depth 1 https://github.com/ggml-org/llama.cpp /opt/llama.cpp
    pip3 install --no-cache-dir gguf sentencepiece protobuf
    cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
        -DGGML_CUDA=ON -DLLAMA_CURL=OFF -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES="80;90"
    cmake --build /opt/llama.cpp/build -j4

%environment
    export LLAMA_CPP_DIR=/opt/llama.cpp

%test
    # llama_cpp is deliberately NOT imported here: its compiled libllama.so
    # is linked against libcuda.so.1, which only exists on a host with a
    # real NVIDIA driver, bind-mounted in via `--nv` -- neither is present
    # during `apptainer build`/`%test` (no GPU is attached at build time),
    # so `import llama_cpp` fails here unconditionally regardless of
    # whether the build itself succeeded. Verify it for real once, at job
    # runtime: `apptainer exec --nv nuextract.sif python3 -c "import llama_cpp"`.
    python3 -c "import torch, transformers, peft, huggingface_hub; print('python deps ok (excl. llama_cpp -- see comment above)')"
    find / -xdev -name "libllama.so" -path "*llama_cpp*" 2>/dev/null | grep -q . && echo "llama_cpp shared library built ok"
    find /opt/llama.cpp/build -name "llama-quantize" -type f | grep -q . && echo "llama-quantize built ok"
    test -f /opt/llama.cpp/convert_hf_to_gguf.py && echo "convert_hf_to_gguf.py present ok"

%labels
    author chapter-segmentation NuExtract-2.0-4B fine-tuning pilot
    version 1.0

%help
    Container for the NuExtract-2.0-4B LoRA fine-tuning pilot
    (docs/superpowers/specs/2026-08-10-nuextract2-finetuning-pilot-design.md).
    Built on NVIDIA's PyTorch image; adds transformers/peft/accelerate,
    a CUDA-enabled llama-cpp-python, and a from-source llama.cpp build
    for GGUF conversion/quantization. See evaluation/hpc/README.md.
